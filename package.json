{
  "name": "gtm-toolkit",
  "version": "2.0.0",
  "description": "Go-to-market as code. Declare positioning, personas, messaging and topics in your repo, lint content against them, and compile robots.txt, sitemap.xml, llms.txt and an agent-readable GTM brief.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gtm": "dist/cli.js",
    "gtm-toolkit": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-schemas.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "gtm-as-code",
    "go-to-market",
    "product-marketing",
    "positioning",
    "messaging",
    "content-lint",
    "seo",
    "geo",
    "llms-txt",
    "robots-txt",
    "sitemap",
    "ai-agents"
  ],
  "author": "Raz Kaplan (https://www.gtmascode.dev)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/razkaplan/gtm-toolkit.git"
  },
  "homepage": "https://www.gtmascode.dev/toolkit",
  "bugs": {
    "url": "https://github.com/razkaplan/gtm-toolkit/issues"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "yaml": "^2.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/picomatch": "^4.0.3",
    "typescript": "^5.6.3",
    "vitest": "^3.2.0"
  },
  "files": [
    "dist/",
    "schemas/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  }
}
